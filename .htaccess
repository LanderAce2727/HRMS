Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^(?:storage|uploads|db|scripts|server|backups|templates|\.git|\.codex|\.agents|\.aws)(?:/|$) - [F,L,NC]
RewriteRule \.(?:sql|md|log|ini|env|bak)$ - [F,L,NC]
RewriteRule ^(?:api/(?:system|login|logout|apply|session)\.php|assets/.*\.(?:css|js|svg|png|jpg|jpeg|webp|ico|woff2))$ - [L,NC]
RewriteRule ^router\.php$ - [L]
RewriteRule ^(.*)$ router.php?route=$1 [QSA,L]
