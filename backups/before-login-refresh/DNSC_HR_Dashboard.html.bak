<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DNSC | HR Dashboard</title><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet"><style>
:root{--bg:#f5f8fe;--panel:#fff;--ink:#142348;--muted:#71809e;--border:#e5ebf5;--blue:#326bfa;--cyan:#17b9e0;--green:#0eaa7a;--amber:#db8b14;--red:#df4e62;--shadow:0 10px 30px rgba(33,68,136,.05)}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px 'DM Sans',sans-serif}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #8caeff;outline-offset:2px}.app{display:flex;min-height:100vh}.sidebar{width:248px;flex:none;background:#fff;border-right:1px solid var(--border);padding:28px 15px;display:flex;flex-direction:column;gap:32px}.brand{display:flex;align-items:center;gap:12px;padding:0 10px}.logo{width:42px;height:42px;border-radius:13px;border:1px solid #cbdaf7;background:#f3f7ff}.brand b{font:700 21px Outfit}.brand small{display:block;color:var(--muted);font-size:11px;letter-spacing:.08em}.navlabel{padding:0 13px;margin:0 0 10px;font-size:10px;font-weight:700;color:#9aa7bd;letter-spacing:.14em}.nav{display:grid;gap:5px}.nav button{width:100%;display:flex;align-items:center;gap:12px;padding:12px 13px;background:none;border:0;border-radius:11px;text-align:left;color:#62718f;font-weight:600}.nav button:hover{background:#f5f8ff}.nav button.active{color:var(--blue);background:#edf3ff}.nav svg{width:19px;height:19px}.sidebarfoot{margin-top:auto;background:#f0f5ff;padding:15px;border-radius:14px;color:#536585;font-size:12px}.sidebarfoot b{display:block;color:var(--ink);margin-bottom:4px}.main{min-width:0;flex:1;padding:25px clamp(18px,3vw,46px) 45px;max-width:1650px;margin:auto}.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:32px}.crumb{color:var(--muted);font-size:13px}.crumb strong{color:var(--ink)}.righttop{display:flex;align-items:center;gap:14px}.avatar{width:39px;height:39px;display:grid;place-items:center;background:#dfeaff;border-radius:12px;color:var(--blue);font-weight:700}.user{font-weight:700;font-size:13px}.user small{display:block;color:var(--muted);font-weight:400}.heading{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:24px}.heading h1{font:700 clamp(25px,3vw,33px) Outfit;margin:0 0 6px}.heading p{margin:0;color:var(--muted)}.btn{border:1px solid var(--border);border-radius:11px;padding:10px 15px;background:#fff;color:var(--ink);font-weight:700}.btn.primary{background:linear-gradient(100deg,var(--blue),var(--cyan));color:white;border:0}.btn.small{padding:7px 10px;font-size:12px}.btn.good{color:var(--green)}.btn.bad{color:var(--red)}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:20px}.metric,.panel{background:var(--panel);border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}.metric{padding:21px}.metrichead{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-weight:600;font-size:12px}.metricicon{height:38px;width:38px;border-radius:12px;background:#eef4ff;display:grid;place-items:center;color:var(--blue);font-size:19px}.metric strong{display:block;font:700 31px Outfit;margin:13px 0 4px}.metric small{color:var(--muted)}.metric small em{color:var(--green);font-style:normal;font-weight:700}.dashboardgrid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,1fr);gap:18px}.panel{padding:21px;margin-bottom:18px;min-width:0}.panelhead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.panelhead h2{font:600 18px Outfit;margin:0}.panelhead span{font-size:12px;color:var(--muted)}.chart{height:220px;display:flex;align-items:end;gap:13px;border-bottom:1px solid var(--border);padding:15px 5px 0}.barcol{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:end;height:100%;gap:9px}.bar{width:min(100%,37px);border-radius:7px 7px 0 0;background:linear-gradient(180deg,#65a5ff,#326bfa);min-height:3px}.barcol small{font-size:11px;color:var(--muted);margin-bottom:-23px}.chartwrap{padding-bottom:27px}.legend{font-size:12px;color:var(--muted);margin-top:17px}.dot{display:inline-block;width:9px;height:9px;background:var(--blue);border-radius:50%;margin-right:5px}.quick{display:grid;grid-template-columns:1fr 1fr;gap:10px}.quick button{padding:15px;border:1px solid var(--border);border-radius:13px;background:#f9fbff;text-align:left;font-weight:700;color:var(--ink)}.quick button:hover{border-color:#9dbbff}.quick span{display:block;color:var(--blue);font-size:21px;margin-bottom:8px}.activity{display:grid;gap:16px}.event{display:flex;gap:12px}.eventicon{height:34px;width:34px;flex:none;display:grid;place-items:center;background:#eef4ff;color:var(--blue);border-radius:11px}.event b{font-size:13px}.event p{color:var(--muted);font-size:12px;margin:3px 0 0}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;text-align:left;white-space:nowrap}th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#8b99b1;background:#f9fbff}td,th{padding:13px 12px;border-bottom:1px solid var(--border)}td{font-size:13px}tr:last-child td{border-bottom:0}.status{display:inline-block;border-radius:50px;padding:5px 10px;font-size:11px;font-weight:700}.pending{color:#b87a0b;background:#fff5dc}.approved,.present{color:#078e65;background:#e4f8f0}.rejected,.absent{color:#c83b53;background:#ffebef}.late{color:#b87a0b;background:#fff5dc}.toolbar{display:flex;gap:10px;margin-bottom:17px;flex-wrap:wrap}.toolbar input,.toolbar select{padding:11px 13px;border:1px solid var(--border);border-radius:11px;background:white;color:var(--ink)}.toolbar input{flex:1;min-width:180px}.empty{color:var(--muted);padding:25px;text-align:center}.page{display:none}.page.active{display:block}.note{font-size:12px;color:var(--muted);margin:12px 0}.notice{background:#edf4ff;border:1px solid #d6e5ff;border-radius:12px;padding:12px 15px;color:#51678f;font-size:12px;margin-bottom:20px}.mobilemenu{display:none}.badgecount{background:#edf3ff;color:var(--blue);padding:3px 8px;border-radius:20px;font-size:11px;margin-left:auto}@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,1fr)}.dashboardgrid{grid-template-columns:1fr}}@media(max-width:760px){.sidebar{display:none;position:fixed;z-index:10;inset:0 auto 0 0;box-shadow:0 0 0 100vmax #13234666}.sidebar.open{display:flex}.mobilemenu{display:inline-flex}.main{padding:18px}.heading{align-items:start;flex-direction:column}.metrics{gap:10px}.metric{padding:15px}.metric strong{font-size:25px}.user{display:none}.quick{grid-template-columns:1fr 1fr}}@media(max-width:400px){.metrics{grid-template-columns:1fr 1fr}.metrichead{font-size:11px}.metricicon{display:none}}
</style></head><body><div class="app"><aside class="sidebar" id="sidebar"><div class="brand"><div class="logo" aria-label="Blank school logo"></div><div><b>DNSC</b><small>FACULTY & HR PORTAL</small></div></div><div><p class="navlabel">WORKSPACE</p><nav class="nav" id="nav"><button class="active" data-page="overview">◫ &nbsp; Dashboard</button><button data-page="applicants">♧ &nbsp; Applicants <span class="badgecount" id="pendingNav">0</span></button><button data-page="faculty">♙ &nbsp; Faculty Members</button><button data-page="attendance">◷ &nbsp; RFID Attendance</button><button data-page="leave">▤ &nbsp; Leave Requests</button><button data-page="payroll">▣ &nbsp; Payroll</button><button data-page="reports">▥ &nbsp; Reports</button></nav></div><div class="sidebarfoot"><b>HR Management System</b>DNSC administration workspace<br><br>Prototype dashboard · Demo data</div></aside><main class="main"><header class="topbar"><div style="display:flex;align-items:center;gap:10px"><button class="btn mobilemenu" id="menuBtn" aria-label="Open navigation">☰</button><span class="crumb">DNSC / HR Management / <strong id="crumb">Dashboard</strong></span></div><div class="righttop"><span style="color:var(--muted);font-size:12px" id="today"></span><div class="avatar">HR</div><div class="user">HR Administrator<small>Admin account</small></div></div></header><div class="notice">Interactive frontend prototype. All records shown are sample data; decisions are saved only in this browser. Connect to your PHP backend and database before real use.</div>
<section class="page active" id="overview"><div class="heading"><div><h1>HR Dashboard</h1><p>Welcome back! Here's what's happening at DNSC today.</p></div><button class="btn primary" data-go="reports">↗ &nbsp; View reports</button></div><div class="metrics" id="metrics"></div><div class="dashboardgrid"><div><div class="panel"><div class="panelhead"><h2>Attendance Overview</h2><span>Last 7 days · sample</span></div><div class="chartwrap"><div class="chart" id="chart"></div></div><div class="legend"><span class="dot"></span> Faculty present per day</div></div><div class="panel"><div class="panelhead"><h2>Recent Applications</h2><button class="btn small" data-go="applicants">View all →</button></div><div class="tablewrap" id="recentApps"></div></div></div><div><div class="panel"><div class="panelhead"><h2>Quick Actions</h2></div><div class="quick"><button data-go="applicants"><span>♧</span>Review applicants</button><button data-go="attendance"><span>◷</span>View attendance</button><button data-go="leave"><span>▤</span>Manage leave</button><button data-go="payroll"><span>▣</span>Payroll summary</button></div></div><div class="panel"><div class="panelhead"><h2>Recent Activity</h2><span>Sample feed</span></div><div class="activity" id="activity"></div></div></div></div></section>
<section class="page" id="applicants"><div class="heading"><div><h1>Instructor Applications</h1><p>Review incoming teaching applications and decisions.</p></div></div><div class="panel"><div class="toolbar"><input id="appSearch" placeholder="Search applicant or position" aria-label="Search applicants"><select id="appFilter" aria-label="Filter application status"><option value="All">All statuses</option><option>Pending</option><option>Approved</option><option>Rejected</option></select></div><div class="tablewrap" id="appTable"></div></div></section>
<section class="page" id="faculty"><div class="heading"><div><h1>Faculty Members</h1><p>Directory of registered instructors.</p></div></div><div class="panel"><div class="toolbar"><input id="facultySearch" placeholder="Search faculty" aria-label="Search faculty"></div><div class="tablewrap" id="facultyTable"></div></div></section>
<section class="page" id="attendance"><div class="heading"><div><h1>RFID Attendance</h1><p>Daily faculty attendance records and scan logs.</p></div><button class="btn" id="exportAttendance">↓ Export CSV</button></div><div class="metrics" id="attendanceMetrics"></div><div class="panel"><div class="toolbar"><input id="attendanceSearch" placeholder="Search faculty or RFID ID" aria-label="Search attendance"><select id="attendanceFilter"><option value="All">All statuses</option><option>Present</option><option>Late</option><option>Absent</option></select></div><div class="tablewrap" id="attendanceTable"></div><p class="note">Live RFID scanning requires a USB reader connected to an attendance workstation and a secure PHP API.</p></div></section>
<section class="page" id="leave"><div class="heading"><div><h1>Leave Requests</h1><p>Review faculty leave requests and update their status.</p></div></div><div class="panel"><div class="tablewrap" id="leaveTable"></div></div></section>
<section class="page" id="payroll"><div class="heading"><div><h1>Payroll Overview</h1><p>Sample payroll tracking for the current pay period.</p></div></div><div class="metrics" id="payrollMetrics"></div><div class="panel"><div class="panelhead"><h2>Payroll Status</h2><span>Demo only</span></div><div class="tablewrap" id="payrollTable"></div></div></section>
<section class="page" id="reports"><div class="heading"><div><h1>Reports</h1><p>Export sample HR records for review.</p></div></div><div class="panel"><div class="panelhead"><h2>Available Exports</h2></div><div class="quick"><button data-export="applications"><span>⇩</span>Applications CSV</button><button data-export="attendance"><span>⇩</span>Attendance CSV</button><button data-export="leave"><span>⇩</span>Leave Requests CSV</button><button data-export="faculty"><span>⇩</span>Faculty CSV</button></div><p class="note">Exports contain demo records only and are generated locally in your browser.</p></div></section>
</main></div><script>
const defaults={applications:[{id:1,name:'Maria Santos',email:'maria@example.com',position:'Full-time Instructor',date:'Oct 21, 2026',status:'Pending'},{id:2,name:'John Reyes',email:'john@example.com',position:'Part-time Instructor',date:'Oct 20, 2026',status:'Pending'},{id:3,name:'Angela Cruz',email:'angela@example.com',position:'Full-time Instructor',date:'Oct 18, 2026',status:'Approved'},{id:4,name:'Paolo Garcia',email:'paolo@example.com',position:'Part-time Instructor',date:'Oct 17, 2026',status:'Pending'},{id:5,name:'Nina Flores',email:'nina@example.com',position:'Full-time Instructor',date:'Oct 15, 2026',status:'Rejected'}],leave:[{id:1,name:'Ana Mendoza',type:'Sick Leave',dates:'Oct 26–27',status:'Pending'},{id:2,name:'Mark Dela Cruz',type:'Personal Leave',dates:'Oct 29',status:'Pending'},{id:3,name:'Jessa Ramos',type:'Sick Leave',dates:'Oct 22',status:'Approved'}]};let state;try{state=JSON.parse(localStorage.getItem('dnsc_hr_demo_v1'))||structuredClone(defaults)}catch(e){state=JSON.parse(JSON.stringify(defaults))}const faculty=[{name:'Ana Mendoza',department:'Information Technology',rfid:'RFID-1001',email:'ana@dnsc.edu.ph'},{name:'Mark Dela Cruz',department:'Education',rfid:'RFID-1002',email:'mark@dnsc.edu.ph'},{name:'Jessa Ramos',department:'Business',rfid:'RFID-1003',email:'jessa@dnsc.edu.ph'},{name:'Carlo Lim',department:'Information Technology',rfid:'RFID-1004',email:'carlo@dnsc.edu.ph'},{name:'Liza Torres',department:'Arts & Sciences',rfid:'RFID-1005',email:'liza@dnsc.edu.ph'}];const attendance=[{name:'Ana Mendoza',rfid:'RFID-1001',in:'07:45 AM',out:'04:35 PM',status:'Present'},{name:'Mark Dela Cruz',rfid:'RFID-1002',in:'08:24 AM',out:'04:45 PM',status:'Late'},{name:'Jessa Ramos',rfid:'RFID-1003',in:'07:52 AM',out:'04:30 PM',status:'Present'},{name:'Carlo Lim',rfid:'RFID-1004',in:'—',out:'—',status:'Absent'},{name:'Liza Torres',rfid:'RFID-1005',in:'07:40 AM',out:'04:30 PM',status:'Present'}];const payroll=[{name:'Ana Mendoza',period:'Oct 1–15',status:'Processed'},{name:'Mark Dela Cruz',period:'Oct 1–15',status:'Pending'},{name:'Jessa Ramos',period:'Oct 1–15',status:'Processed'},{name:'Carlo Lim',period:'Oct 1–15',status:'Pending'}];const $=id=>document.getElementById(id),save=()=>{try{localStorage.setItem('dnsc_hr_demo_v1',JSON.stringify(state))}catch(e){}};const safe=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const pill=s=>`<span class="status ${['Approved','Processed','Present'].includes(s)?'approved':['Rejected','Absent'].includes(s)?'rejected':'pending'}">${safe(s)}</span>`;const table=(heads,rows)=>`<table><thead><tr>${heads.map(h=>`<th>${safe(h)}</th>`).join('')}</tr></thead><tbody>${rows.length?rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join('')}</tr>`).join(''):`<tr><td colspan="${heads.length}" class="empty">No matching records</td></tr>`}</tbody></table>`;function metric(label,value,sub,icon){return `<article class="metric"><div class="metrichead">${label}<span class="metricicon">${icon}</span></div><strong>${value}</strong><small>${sub}</small></article>`}function render(){const pending=state.applications.filter(a=>a.status==='Pending').length;const leavePending=state.leave.filter(a=>a.status==='Pending').length;$('pendingNav').textContent=pending;$('metrics').innerHTML=metric('Total Faculty','128','Registered faculty · sample','♙')+metric('Present Today','112','<em>87.5%</em> attendance · sample','◷')+metric('Pending Applicants',pending,'Awaiting review','♧')+metric('Leave Requests',leavePending,'Awaiting approval','▤');$('chart').innerHTML=[96,108,103,115,112,84,92].map((n,i)=>`<div class="barcol"><div class="bar" title="${n} faculty" style="height:${n/128*100}%"></div><small>${['Sat','Sun','Mon','Tue','Wed','Thu','Fri'][i]}</small></div>`).join('');$('recentApps').innerHTML=table(['Applicant','Position','Status'],state.applications.slice(0,4).map(a=>[safe(a.name),safe(a.position),pill(a.status)]));$('activity').innerHTML=[['✓','Application review','Review and approve incoming instructor applications'],['◷','Attendance logs','Track faculty RFID time-in and time-out'],['▤','Leave management','Review and respond to leave requests']].map(a=>`<div class="event"><div class="eventicon">${a[0]}</div><div><b>${a[1]}</b><p>${a[2]}</p></div></div>`).join('');renderApplicants();renderLeave();renderFaculty();renderAttendance();renderPayroll()}
function renderApplicants(){const q=$('appSearch').value.toLowerCase(),f=$('appFilter').value;const rows=state.applications.filter(a=>(a.name+' '+a.position).toLowerCase().includes(q)&&(f==='All'||a.status===f));$('appTable').innerHTML=table(['Applicant','Email','Position','Applied','Status','Action'],rows.map(a=>[safe(a.name),safe(a.email),safe(a.position),safe(a.date),pill(a.status),a.status==='Pending'?`<button class="btn small good" data-app="${a.id}" data-status="Approved">Approve</button> <button class="btn small bad" data-app="${a.id}" data-status="Rejected">Reject</button>`:'—']))}function renderLeave(){$('leaveTable').innerHTML=table(['Faculty','Leave type','Dates','Status','Action'],state.leave.map(a=>[safe(a.name),safe(a.type),safe(a.dates),pill(a.status),a.status==='Pending'?`<button class="btn small good" data-leave="${a.id}" data-status="Approved">Approve</button> <button class="btn small bad" data-leave="${a.id}" data-status="Rejected">Reject</button>`:'—']))}function renderFaculty(){let q=$('facultySearch').value.toLowerCase();$('facultyTable').innerHTML=table(['Faculty','Department','Email','RFID ID'],faculty.filter(a=>Object.values(a).join(' ').toLowerCase().includes(q)).map(a=>[safe(a.name),safe(a.department),safe(a.email),safe(a.rfid)]))}function renderAttendance(){let q=$('attendanceSearch').value.toLowerCase(),f=$('attendanceFilter').value;let rows=attendance.filter(a=>(a.name+' '+a.rfid).toLowerCase().includes(q)&&(f==='All'||f===a.status));$('attendanceTable').innerHTML=table(['Faculty','RFID ID','Time In','Time Out','Status'],rows.map(a=>[safe(a.name),safe(a.rfid),safe(a.in),safe(a.out),pill(a.status)]));$('attendanceMetrics').innerHTML=metric('Present','3','On time','✓')+metric('Late','1','Arrived after schedule','◷')+metric('Absent','1','No scan recorded','—')+metric('Total Logs','5','Sample faculty records','▤')}function renderPayroll(){$('payrollMetrics').innerHTML=metric('Pay Period','Oct 1–15','2026 sample period','▣')+metric('Processed','2','Demo records','✓')+metric('Pending','2','Awaiting processing','◷')+metric('Total Records','4','Sample entries','▤');$('payrollTable').innerHTML=table(['Faculty','Pay Period','Status'],payroll.map(a=>[safe(a.name),safe(a.period),pill(a.status)]))}function go(p){document.querySelectorAll('.page').forEach(el=>el.classList.toggle('active',el.id===p));document.querySelectorAll('[data-page]').forEach(el=>el.classList.toggle('active',el.dataset.page===p));$('crumb').textContent=({overview:'Dashboard',applicants:'Applicants',faculty:'Faculty Members',attendance:'RFID Attendance',leave:'Leave Requests',payroll:'Payroll',reports:'Reports'})[p];$('sidebar').classList.remove('open');window.scrollTo({top:0,behavior:'smooth'})}document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.page)go(b.dataset.page);if(b.dataset.go)go(b.dataset.go);if(b.dataset.app){const a=state.applications.find(a=>a.id===Number(b.dataset.app));if(a&&a.status==='Pending'&&confirm(`${b.dataset.status} ${a.name}'s application? (Demo only)`)){a.status=b.dataset.status;save();render()}}if(b.dataset.leave){const a=state.leave.find(a=>a.id===Number(b.dataset.leave));if(a&&a.status==='Pending'&&confirm(`${b.dataset.status} ${a.name}'s leave request? (Demo only)`)){a.status=b.dataset.status;save();render()}}if(b.dataset.export)exportCSV(b.dataset.export)});['appSearch','appFilter'].forEach(id=>$(id).addEventListener('input',renderApplicants));$('facultySearch').addEventListener('input',renderFaculty);['attendanceSearch','attendanceFilter'].forEach(id=>$(id).addEventListener('input',renderAttendance));$('menuBtn').onclick=()=>$('sidebar').classList.toggle('open');$('today').textContent=new Intl.DateTimeFormat('en-PH',{month:'short',day:'numeric',year:'numeric'}).format(new Date());function exportCSV(kind){let data=kind==='applications'?state.applications:kind==='leave'?state.leave:kind==='faculty'?faculty:attendance;let keys=Object.keys(data[0]||{});let csv=[keys.join(','),...data.map(a=>keys.map(k=>'"'+String(a[k]??'').replace(/"/g,'""')+'"').join(','))].join('\r\n');let url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));let link=document.createElement('a');link.href=url;link.download='DNSC_'+kind+'_demo.csv';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}$('exportAttendance').onclick=()=>exportCSV('attendance');render();</script></body></html>
